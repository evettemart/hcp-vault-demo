# Minimum required environment variables for hcp-vault-demo deployment

# AWS provider authentication
export AWS_ACCESS_KEY_ID="<aws-access-key-id>"
export AWS_SECRET_ACCESS_KEY="<aws-secret-access-key>"
export AWS_REGION="us-east-1"
# export AWS_SESSION_TOKEN="<aws-session-token>"  # only for temporary credentials

# HCP provider authentication
export HCP_CLIENT_ID="<hcp-client-id>"
export HCP_CLIENT_SECRET="<hcp-client-secret>"

# Required by terraform/hcp-vault-aws provider config
# Set this to your HCP project ID, or replace project_id in terraform/hcp-vault-aws/vault-cluster/prod.tfvars
export TF_VAR_project_id="<hcp-project-id>"
