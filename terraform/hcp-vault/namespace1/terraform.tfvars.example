vault_addr  = "https://vault.example.com:8200"
vault_token = "<vault-admin-token>"

namespace = "admin/namespace1"
policy_folder = "namespace1"

# Secret engine mount path naming convention:
# <namespace-team>/<cloud-account>/<environment>/<name>
# Example: pcs/cloudaccount1/non-prod/kv-v2-test
#
# Policy naming convention (derived from nested policy file paths):
# <namespace-team>/<cloud-account>/<environment>/<name>
# Example policy files:
# policies/namespace1/pcs/cloudaccount1/non-prod/kv-v2-test-writer.hcl
# policies/namespace1/pcs/cloudaccount1/non-prod/kv-v2-test-consumer.hcl

kv_engines = {
  "pcs/cloudaccount1/non-prod/kv-v2-test" = {
    mount_description    = "Namespace1 non-prod KV v2"
    max_versions         = 20
    cas_required         = false
    delete_version_after = 0
  }

  "pcs/cloudaccount1/prod/kv-v2" = {
    mount_description    = "Namespace1 prod KV v2"
    max_versions         = 20
    cas_required         = true
    delete_version_after = 0
  }
}

# Optional: SSH engines keyed by mount path.
ssh_engines = {}

