vault_addr  = "https://vault.example.com:8200"
vault_token = "<vault-admin-token>"

admin_namespace         = "admin"
create_standard_admin_policies = true
create_child_namespaces = true

child_namespaces = [
  "namespace1",
  "namespace2",
  "namespace3"
]

auth_methods = {
  oidc = {
    type        = "oidc"
    description = "Admin OIDC auth"
  }
  jwt = {
    type        = "jwt"
    description = "Admin JWT auth"
  }
}

# Optional: set to true to configure OIDC backend details via modules/oidc.
configure_oidc = false

# Optional: configure one or more OIDC auth methods (preferred for multiple methods).
# When this map is set, keys are mount paths and each method has its own config.
# oidc_auth_methods = {
#   oidc = {
#     description        = "Admin OIDC auth"
