vault_addr  = "https://vault.example.com:8200"
vault_token = "<vault-admin-token>"

admin_namespace         = "admin"
create_standard_admin_policies = true
create_child_namespaces = true

child_namespaces = [
  "namespace1",
  "namespace2",
  "namespace3"
]

auth_methods = {
  oidc = {
    type        = "oidc"
    description = "Admin OIDC auth"
  }
  jwt = {
    type        = "jwt"
    description = "Admin JWT auth"
  }
}

# Optional: set to true to configure OIDC backend details via modules/oidc.
configure_oidc = false

# Optional: configure one or more OIDC auth methods (preferred for multiple methods).
# When this map is set, keys are mount paths and each method has its own config.
# oidc_auth_methods = {
#   oidc = {
#     description        = "Admin OIDC auth"
#     oidc_discovery_url = "https://login.microsoftonline.com/<tenant-id>/v2.0"
#     oidc_client_id     = "<oidc-client-id>"
#     oidc_client_secret = "<oidc-client-secret>"
#     default_role       = "aad"
#     provider_config = {
#       provider = "azure"
#     }
#     roles = {
#       aad = {
#         user_claim            = "email"
#         groups_claim          = "groups"
#         allowed_redirect_uris = [
#           "https://vault.example.com:8200/oidc/callback",
#           "https://vault.example.com:8200/ui/vault/auth/oidc/oidc/callback",
#           "http://localhost:8250/oidc/callback"
#         ]
#         bound_claims_type     = "string"
#         bound_claims = {
#           groups = "<azure-group-object-id>"
#         }
#         oidc_scopes          = ["profile"]
#         verbose_oidc_logging = true
#       }
#     }
#   }
#
#   oidc_alt = {
#     description        = "Admin alternate OIDC auth"
#     oidc_discovery_url = "https://login.microsoftonline.com/<tenant-id>/v2.0"
#     oidc_client_id     = "<alt-oidc-client-id>"
#     oidc_client_secret = "<alt-oidc-client-secret>"
