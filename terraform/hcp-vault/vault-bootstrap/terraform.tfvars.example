# Optional: manage identity groups per namespace.
# External groups get an OIDC mount accessor so aliases map to the right auth
# backend. You do NOT need to paste the accessor ID: reference the OIDC mount by
# name via `oidc_mount` (the key used in oidc_auth_methods) and Terraform
# resolves the accessor from the deployed OIDC module output.
#
# Accessor resolution order (per group):
#   1. group `oidc_mount`      -> module.oidc_admin[<mount>].accessor
#   2. namespace `oidc_mount`  -> module.oidc_admin[<mount>].accessor
#   3. namespace `oidc_accessor` literal (back-compat, discouraged)
#   4. inferred admin default when exactly one OIDC method exists (or key `oidc`)
#
# Keys should be: `admin` for admin namespace groups, and child names like
# `namespace1` for admin/namespace1. Do not prefix child keys with `admin/`.
# namespace_groups = {
#   admin = {
#     # Two OIDC backends (oidc and oidc_alt from oidc_auth_methods) each own a
#     # set of external groups. Set oidc_mount per group to bind it to a backend.
#     groups = {
#       # --- Groups for the primary OIDC backend (oidc) ---
#       "PPC-VAULT-ADMINS" = {
#         group_type = "internal"
#         policies   = ["policy-admin"]
#       }
#       "CS-USERS" = {
#         group_type = "external"
#         # Policy naming convention for secret engines:
#         # <namespace-team>/<cloud-account>/<environment>/<name>
#         # Example:
#         # pcs/cloudaccount1/non-prod/kv-v2-test-consumer
#         policies   = ["pcs/cloudaccount1/non-prod/kv-v2-test-consumer"]
#         alias_name = "<azure-group-object-id>"
#         oidc_mount = "oidc"
#       }
#       "PLATFORM-ADMINS" = {
#         group_type = "external"
#         policies   = ["policy-admin"]
#         alias_name = "<platform-admins-azure-group-object-id>"
#         oidc_mount = "oidc"
#       }
#
#       # --- Groups for the alternate OIDC backend (oidc_alt) ---
#       "PARTNER-USERS" = {
#         group_type = "external"
#         policies   = ["pcs/cloudaccount1/non-prod/kv-v2-test-consumer"]
#         alias_name = "<partner-azure-group-object-id>"
#         oidc_mount = "oidc_alt"
#       }
#       "PARTNER-ADMINS" = {
#         group_type = "external"
#         policies   = ["pcs/cloudaccount1/non-prod/kv-v2-test-writer"]
#         alias_name = "<partner-admins-azure-group-object-id>"
#         oidc_mount = "oidc_alt"
#       }
#     }
#   }
# }

# Baseline policies are loaded from ../policies/admin/*.hcl.
# Optional overrides/additional policies can still be supplied via this map.
policies = {}

