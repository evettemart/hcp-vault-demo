# -----------------------------------------------------------------------------
# PROD EXAMPLE (workspace: prod)
# Copy this file to prod.tfvars and keep these defaults or adjust as needed.
# -----------------------------------------------------------------------------
aws_region_1                 = "eu-west-1"
aws_region_2                 = "us-east-1"
aws_region_3                 = "ap-southeast-1"
environment                  = "prod"
name_prefix                  = "vault-hcp-demo"
topology_scenario            = "prod"
vpc_region_1_cidr_block      = "10.20.0.0/24"
public_subnet_region_1_cidr  = "10.20.0.0/25"
private_subnet_region_1_cidr = "10.20.0.128/25"
vpc_region_2_cidr_block      = "10.21.0.0/24"
public_subnet_region_2_cidr  = "10.21.0.0/25"
private_subnet_region_2_cidr = "10.21.0.128/25"
vpc_region_3_cidr_block      = "10.22.0.0/24"
public_subnet_region_3_cidr  = "10.22.0.0/25"
private_subnet_region_3_cidr = "10.22.0.128/25"

enable_hcp_tgw_acceptance = false
enable_hcp_routes         = false

hcp_provider_account_id_region_1 = null
hcp_provider_account_id_region_2 = null
hcp_provider_account_id_region_3 = null

hvn_region_1_primary_cidr         = "172.25.16.0/24"
hvn_region_2_primary_cidr         = "172.26.16.0/24"
hvn_region_3_primary_cidr         = "172.27.16.0/24"
hvn_region_2_dr_for_region_1_cidr = "172.28.16.0/24"
hvn_region_3_dr_for_region_2_cidr = "172.29.16.0/24"
hvn_region_1_dr_for_region_3_cidr = "172.30.16.0/24"

# -----------------------------------------------------------------------------
# NON-PROD EXAMPLE (workspace: non-prod)
# Copy this file to non-prod.tfvars and uncomment/adjust the block below.
# -----------------------------------------------------------------------------
# environment                  = "non-prod"
# name_prefix                  = "vault-hcp-nonprod"
# topology_scenario            = "non-prod"
#
# # Use only region 1 + region 2 VPCs in non-prod mode.
# aws_region_1                 = "eu-west-1"
# aws_region_2                 = "us-east-1"
# vpc_region_1_cidr_block      = "10.20.0.0/24"
# public_subnet_region_1_cidr  = "10.20.0.0/25"
# private_subnet_region_1_cidr = "10.20.0.128/25"
# vpc_region_2_cidr_block      = "10.21.0.0/24"
# public_subnet_region_2_cidr  = "10.21.0.0/25"
# private_subnet_region_2_cidr = "10.21.0.128/25"
#
# enable_hcp_tgw_acceptance = false
# enable_hcp_routes         = true
#
# # Populate after first HCP apply/outputs.
# hcp_provider_account_id_region_1 = "<hcp-provider-account-id>"
# hcp_provider_account_id_region_2 = "<hcp-provider-account-id>"
#
# hvn_region_1_primary_cidr         = "172.25.16.0/24"
# hvn_region_2_dr_for_region_1_cidr = "172.28.16.0/24"

# Optional: test databases for Vault database secret engine validation
# enable_test_databases     = true
# test_database_instance_type = "db.t4g.micro"
# test_database_allowed_cidrs = [
#   "10.20.0.0/24",      # region 1 VPC
#   "172.25.16.0/24",    # HVN region 1 primary
#   "172.28.16.0/24"     # HVN region 2 DR for region 1
# ]
# test_postgres_username = "vaultadmin"
# test_postgres_password = "replace-me"
# test_postgres_database = "appdb"
# test_mysql_username    = "vaultadmin"
# test_mysql_password    = "replace-me"
# test_mysql_database    = "appdb"
