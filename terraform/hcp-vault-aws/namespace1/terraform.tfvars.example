vault_addr  = "https://vault.example.com:8200"
vault_token = "<vault-admin-token>"

namespace = "admin/namespace1"
policy_folder = "namespace1"

kv_engines = {
  "pcs/cloudaccount1/non-prod/kv-v2-test" = {
    mount_description    = "Namespace1 non-prod KV v2"
    max_versions         = 20
    cas_required         = false
    delete_version_after = 0
  }

  "pcs/cloudaccount1/prod/kv-v2" = {
    mount_description    = "Namespace1 prod KV v2"
    max_versions         = 20
    cas_required         = true
    delete_version_after = 0
  }
}

# Optional: SSH engines keyed by mount path.
ssh_engines = {}

